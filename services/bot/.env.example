# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Same portal -> General Information -> Application ID
DISCORD_CLIENT_ID=paste-your-application-id-here

# Optional. Right-click your server -> Copy Server ID (needs Developer Mode on).
# With this set, slash commands appear instantly instead of taking up to an hour.
DISCORD_GUILD_ID=

# Channel to bridge with the radar's live chat. Anything people say in this
# channel appears on the map, and anything said on the map appears here.
# Right-click the channel -> Copy Channel ID (needs Developer Mode on).
# Leave blank to turn the chat bridge off.
CHAT_CHANNEL_ID=

# Who the map's chat can offer as a ping target.
#
# Leave this blank and the bot remembers everyone it SEES: whoever talks in
# the bridged channel, whoever runs a command, whoever links their account.
# That needs no special permission and cannot break anything, and after a day
# of chat it covers most of the people worth pinging.
#
# Set it to 1 only if you have ALSO switched on "Server Members Intent" in
# the Discord developer portal (Bot -> Privileged Gateway Intents) and added
# GatewayIntentBits.GuildMembers to the intents list in asturio-bot.mjs. Then
# the whole membership is listed from the first minute. Asking for an intent
# that has not been granted stops the bot starting at all, which is exactly
# why this is off unless you say otherwise.
ROSTER_SWEEP=

# Only change if you move the worker.
ASTURIO_WORKER=https://asturio-ai.ralphies1005.workers.dev
