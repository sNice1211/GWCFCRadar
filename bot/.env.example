# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Same portal -> General Information -> Application ID
DISCORD_CLIENT_ID=paste-your-application-id-here

# Optional. Right-click your server -> Copy Server ID (needs Developer Mode on).
# With this set, slash commands appear instantly instead of taking up to an hour.
DISCORD_GUILD_ID=

# Only change if you move the worker.
ASTURIO_WORKER=https://asturio-ai.ralphies1005.workers.dev
